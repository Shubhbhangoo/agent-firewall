.venv/
__pycache__/
.pytest_cache/
*.pyc
audit.log
agent-firewall-test/
*.egg-info/
dist/
build/
*.egg-info/
test install/
# CLI state files, written into the working directory by default
# (firewall task --state, firewall defense --state). Runtime artifacts,
# not source: a committed copy is one run behind whoever ran the CLI last.
mesh.json
tasks.json
identities.json
provenance.json
a2a.json
# Scratch output of full-suite runs. The suite takes ~16 minutes, so it is
# run in shards (run_shards.py) that can outlive a terminal; the logs are
# evidence for one run on one machine, not source, and a committed copy of
# them would be stale before the next push.
_shards/
_full.log
_gate.txt
_gate.err
_run_full.ps1

# pytest basetemp directories. The suite is run with `--basetemp` inside the
# workspace on purpose: the default temp root makes pytest delete its own
# `garbage-*` directories, which the sandbox's safe-delete guard blocks and
# aborts the run on. pytest wipes the directory at session start, so a sharded
# run needs one per shard -- hence the family rather than a single name. They
# are ephemeral by construction and never source.
.pt_*/
.pytest_run/

# Local scratch. A leading underscore marks a file that exists to answer one
# question during one investigation -- the `_p_*` / `_p_lin_*` probe family,
# `_smoke_*` scripts, `_repro*`, `_slice.py`, `_bench_profile.py`. Working
# notes, not source: a committed copy is one investigation behind whoever
# wrote it. Tracked files matching these patterns are unaffected.
_*.py
_*.ps1
_*.txt

# WorkBuddy project memory: local working notes about this repository,
# written for the assistant's own continuity rather than for publication.
.workbuddy-ai/

